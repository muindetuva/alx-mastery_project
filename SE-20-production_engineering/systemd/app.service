[Unit]
Description=Engineering Quote FastAPI service
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/quote-service
EnvironmentFile=/opt/quote-service/.env
ExecStart=/opt/quote-service/.venv/bin/gunicorn main:app --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000
Restart=always

[Install]
WantedBy=multi-user.target
